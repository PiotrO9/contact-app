# Runtime connection used by the NestJS application.
# For Supabase, use the Session pooler or Transaction pooler connection string.
DATABASE_URL="postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[DB-REGION].pooler.supabase.com:5432/postgres"

# Direct connection used by Prisma CLI for migrations and introspection.
# If you do not need a separate direct URL yet, Prisma falls back to DATABASE_URL.
DIRECT_URL="postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth configuration.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Frontend callback that Supabase redirects to after Google login.
# Add this exact URL to Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs.
FRONTEND_URL="http://localhost:5173"
SUPABASE_AUTH_REDIRECT_TO="http://localhost:5173/auth/callback"
SUPABASE_AUTH_ALLOWED_REDIRECT_ORIGINS="http://localhost:5173"
